# VaultCloud TMA Configuration

# Port for the Fastify backend and static web server
PORT=8080
HOST=0.0.0.0

# Telegram Bot configuration
# Required for live Telegram integration. In DEMO_MODE=true, you can leave these as mock values.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_STORAGE_CHAT_ID=your_private_channel_or_chat_id_here

# Mode toggles
# Set DEMO_MODE=true to run the server with in-memory mock storage and pre-seeded sample data
DEMO_MODE=true

# Database location
DATABASE_PATH=./data/vaultcloud.db

# Client application URL (used for CORS and WebApp URL in bot menu)
APP_URL=http://localhost:8080
